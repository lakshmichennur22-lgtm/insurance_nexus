pipeline {
    agent any

    environment {
        NEXUS_URL  = "13.49.68.226:8081"
        NEXUS_REPO = "insurance"
        NPM_CACHE  = "${WORKSPACE}/.npm"
    }

    stages {

        stage('Configure npm') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-creds',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    sh '''
                    npm config set registry http://${NEXUS_URL}/repository/${NEXUS_REPO}/
                    npm config set cache ${NPM_CACHE}
                    npm config set always-auth true
                    npm config set //${NEXUS_URL}/repository/${NEXUS_REPO}/:_authToken=$NEXUS_PASS
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                cd frontend
                npm ci
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                cd frontend
                npm test -- --watch=false
                '''
            }
        }

        stage('Versioning') {
            steps {
                sh '''
                cd frontend
                VERSION="1.0.${BUILD_NUMBER}"
                npm version $VERSION --no-git-tag-version
                '''
            }
        }

        stage('Build Artifact') {
            steps {
                sh '''
                cd frontend
                npm pack
                '''
            }
        }

        stage('Publish to Nexus') {
            steps {
                sh '''
                cd frontend
                npm publish *.tgz
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ CI pipeline completed successfully"
        }
        failure {
            echo "❌ CI pipeline failed"
        }
    }
}
