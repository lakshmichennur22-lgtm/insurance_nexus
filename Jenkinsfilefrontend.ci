pipeline {
    agent any

    environment {
        NEXUS_URL = "http://3.94.52.72:8081/repository/Insurance_raw"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies & Build') {
            steps {
                sh '''
                cd frontend
                npm install
                npm run build

                ZIP_NAME=frontend-build-${BUILD_ID}.zip
                zip -r $ZIP_NAME dist

                echo "ZIP created:"
                ls -lh $ZIP_NAME
                '''
            }
        }

        stage('Upload to Nexus') {
            steps {
                sh '''
                echo "Uploading frontend ZIP to Nexus RAW repo"

                ZIP_NAME=frontend-build-${BUILD_ID}.zip

                echo "Using Nexus URL: $NEXUS_URL"
                echo "Uploading file: frontend/$ZIP_NAME"

                curl -v -u admin:lakshmi \
                --upload-file frontend/$ZIP_NAME \
                "$NEXUS_URL/$ZIP_NAME"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Frontend build & upload completed"
        }
        failure {
            echo "❌ Pipeline failed"
        }
        always {
            cleanWs()
        }
    }
}