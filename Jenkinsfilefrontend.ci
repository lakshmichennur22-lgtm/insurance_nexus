pipeline {
    agent any

    environment {
        NEXUS_URL  = "http://3.94.52.72:8081/repository/Insurance_raw/"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                cd frontend
                npm install
                npm run build
                zip -r frontend-build-${BUILD_ID}.zip dist
                '''
            }
        }
        stage('uploading to nexus') {
            steps {
                sh '''
                echo "Uploading frontend ZIP to Nexus RAW repo"
                echo "${NEXUS_URL}"
                curl -v -u admin:lakshmi \
                -T frontend/frontend-build-${BUILD_ID}.zip \
                $NEXUS_URLfrontend-build-${BUILD_ID}.zip
                '''
            }
        }
        
    }

    post {
        success {
            echo "✅ Frontend build & upload completed"
        }
        failure {
            echo "❌ Pipeline failed"
        }
        always {
            cleanWs()
        }
    }
}
